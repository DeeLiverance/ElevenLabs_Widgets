ELEVENLABS_API_KEY=your_api_key_here
IRON_SESSION_SECRET_KEY=your_32+_char_secret
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=your_agent_id_here

# Absolute path to the 1.0 OpenAI_EL_Voice_Code repo root.
# Used by the "Deploy to hosted" button (/api/deploy) to:
#   1. Copy brand profile JSONs into the sibling repo before deploying.
#   2. Locate and run backend/deploy_widget_config_api_cloudrun.ps1.
# Falls back to ../../../1.0 OpenAI_EL_Voice_Code (relative to this project root) if not set.
# Example (Windows):
EL_VOICE_CODE_REPO_ROOT=R:/Working_Repositories/5.0 Tools/Ai_Agent_tools/1.0 OpenAI_EL_Voice_Code
